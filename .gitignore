# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
streambus
streambus-*
bin/
dist/

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out
coverage.html
coverage.txt
coverage-*.txt
coverage-*.out
test-*-output.txt

# Compiled example/demo binaries (built ad hoc with `go build ./examples/...`,
# not part of `make build`) - allow only known source/doc file types through.
examples/*/*
!examples/*/*.go
!examples/*/*.md
!examples/*/*.yaml
!examples/*/*.yml
!examples/*/*.json
!examples/*/*.sh

# Stray root-level binaries from ad hoc `go build -o <name> ./cmd/...`
/broker
/security
/metadata

# Dependency directories
vendor/
node_modules/

# Go workspace file
go.work
go.work.sum

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Environment and config files
.env
.env.local
*.local.yaml
*.local.toml
secrets/

# Data directories
data/
logs/
*.log

# Build artifacts
tmp/
temp/

# Profiling and benchmarking
*.prof
*.bench
*.cpuprofile
*.memprofile

# Docker
docker-compose.override.yml

# Kubernetes
*.kubeconfig

# Terraform
*.tfstate
*.tfstate.*
.terraform/

# Documentation build artifacts
site/
docs/_build/

# Project planning (kept local, not checked into GitHub)
project-plan/

# Python bytecode and build artifacts
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
